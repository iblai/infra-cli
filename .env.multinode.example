# iblai infra app|stores|sandbox|call — multi-node deployment on existing hosts
# One file serves every command; each reads the keys it needs:
#   iblai infra app init        -f .env   # 1. hub: base software, store endpoints, secrets
#   iblai infra stores setup    -f .env   # 2. stores node (copy of the hub's root)
#   iblai infra app setup       -f .env   # 3. hub: migrations, launch, one-time jobs; beat
#   iblai infra app add         -f .env --host <ip>        # 4. more app nodes
#   iblai infra sandbox setup   -f .env   # 5. KVM sandbox server
#   iblai infra sandbox connect -f .env   # 6. DM <-> sandbox
#   iblai infra call connect    -f .env --call-project <name>   # 7. DM <-> LiveKit
#   iblai infra app sync        -f .env   # hub config -> every node (rolling)
#   iblai infra app verify      -f .env   # containers, health, secrets, endpoints
# Never commit a populated .env — .gitignore blocks .env.* by default.

# ============================================================================
# DEPLOYMENT
# ============================================================================

PROJECT_NAME=acme-prod
BASE_DOMAIN=example.com

# SSH. Hosts can be private addresses reached through SSH_JUMP_HOST (same key).
SSH_PRIVATE_KEY_PATH=~/.ssh/acme-prod
SSH_USER=ubuntu
# SSH_JUMP_HOST=203.0.113.10

# The hub: one app node that also runs the one-time jobs (migrations,
# seeding, tenant, OAuth clients). Every node's config starts as its copy.
HUB_HOST=10.0.1.10
# Other app nodes behind the load balancer (added with `app add`).
APP_HOSTS=10.0.1.11
# The stores node: MongoDB, Meilisearch, ClickHouse, MinIO and celery beat,
# plus any store below left on "stores".
STORES_HOST=10.0.2.10
# Address the app nodes use for the stores node. Default: its primary IPv4.
# STORES_PRIVATE_IP=10.0.2.10
# NODE_ID prefix: <prefix>-app-1 (hub), -app-2.., -stores, -sandbox.
# Assigned once per host and never changed. Default: PROJECT_NAME.
# NODE_ID_PREFIX=acme-prod

# ============================================================================
# STORES — each "stores" (on the stores node) or "managed" (an endpoint)
# ============================================================================

MYSQL=stores
# MYSQL_HOST=mysql.example.internal
# MYSQL_PORT=3306
# MYSQL_ROOT_USERNAME=admin
# MYSQL_ROOT_PASSWORD=

POSTGRES=stores
# POSTGRES_HOST=postgres.example.internal
# POSTGRES_PORT=5432
# The service's master login; it creates the DM's role, databases and extensions.
# POSTGRES_ADMIN_USERNAME=postgres
# POSTGRES_ADMIN_PASSWORD=
# POSTGRES_TLS=true

# edX's Redis and the DM's Redis (may be the same service, different hosts).
REDIS_EDX=stores
# REDIS_EDX_HOST=redis-edx.example.internal
# REDIS_EDX_PORT=6379
# REDIS_EDX_PASSWORD=      # set when the service requires AUTH
# REDIS_EDX_TLS=true
REDIS_DM=stores
# REDIS_DM_HOST=redis-dm.example.internal
# REDIS_DM_PORT=6379
# REDIS_DM_PASSWORD=       # required when managed
# REDIS_DM_TLS=true

# TimescaleDB: auto = on when Postgres runs on the stores node, off when
# managed (managed services rarely ship the extension). true / false force it.
# TIMESCALEDB=auto
# MongoDB on the stores node requires authentication (default true).
# MONGODB_AUTH=true

# ============================================================================
# SOFTWARE
# ============================================================================

# ECR pull key — the servers' default AWS CLI profile; never platform secrets.
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_DEFAULT_REGION=us-east-1

# GitHub PAT with read on the cli-ops and prod-images repos.
GIT_TOKEN=<your github personal access token>
# GITHUB_ORG=iblai
# PROD_IMAGES_REPO=iblai-prod-images
PROD_IMAGES_TAG=main
# CLI_OPS_REPO=iblai-cli-ops
# CLI_OPS_RELEASE_TAG=     # default: the prod-images pin
# Or install locally built wheels instead (no token reaches the servers):
# CLI_OPS_WHEEL=./wheels/ibl_cli-<version>-py3-none-any.whl
# PROD_IMAGES_WHEEL=./wheels/iblai_images-<version>-py3-none-any.whl

# ============================================================================
# PLATFORM (hub: `app init` / `app setup`) — same keys as .env.setup.example
# ============================================================================

ADMIN_USERNAME=platform_admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-min-8-chars
# PLATFORM_NAME=acme         # tenant key; unset = main only
# OPENAI_API_KEY=            # or OPENROUTER_API_KEY
# S3_STATIC_BUCKET=          # both buckets + the S3 key, or none
# S3_MEDIA_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# SMTP_HOST= ... / STRIPE_SECRET_KEY= ... / GOOGLE_SSO_CLIENT_ID= ... / MICROSOFT_SSO_CLIENT_ID= ...
# (see .env.setup.example for the full optional set)

# ============================================================================
# SANDBOX (optional) — KVM host: bare metal, or nested virtualization
# (AWS: 8th-gen Intel, e.g. m8i, launched with NestedVirtualization=enabled)
# ============================================================================

# SANDBOX_HOST=10.0.3.10
# Load balancer hostname routed to the sandbox's :80. Default: sandbox.<BASE_DOMAIN>
# SANDBOX_DOMAIN=sandbox.example.com
# SANDBOX_MAX_SESSIONS=20
# The sandbox needs iblai-cli-ops >= 7.27.0; its own versions / key / wheels:
# SANDBOX_PROD_IMAGES_TAG=
# SANDBOX_CLI_OPS_RELEASE_TAG=
# SANDBOX_AWS_ACCESS_KEY_ID=       # an ECR key with pull on iblai-sandbox-*
# SANDBOX_AWS_SECRET_ACCESS_KEY=
# SANDBOX_CLI_OPS_WHEEL=
# SANDBOX_PROD_IMAGES_WHEEL=
# `sandbox connect`:
# SANDBOX_TENANT=acme-prod-dm      # default <PROJECT_NAME>-dm
# SANDBOX_IMAGE=                   # default: the guest image ref the sandbox reports
# SANDBOX_GRAPH_AGENTS=true        # moves every mentor to the graph runner (needed for VMs)
# SANDBOX_VM_MENTORS=main:agentAI  # platform:mentor name pairs to turn VMs on for
# SANDBOX_VM_EGRESS=none
# SANDBOX_EGRESS_PROFILES=none

# ============================================================================
# CALL SERVER (`call connect`) — or pass --call-project <name>
# ============================================================================

# CALL_HOST=198.51.100.20
# CALL_SSH_PRIVATE_KEY_PATH=~/.ssh/acme-call
# CALL_SSH_USER=ubuntu
